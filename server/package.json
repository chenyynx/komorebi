{
  "name": "dsh-cc-mgw",
  "version": "0.1.0",
  "private": true,
  "description": "dsh-mobile protocol-compatible mobile gateway backed by Claude Code",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "pair": "node dist/cli.js pair",
    "devices": "node dist/cli.js devices"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.9",
    "@vitest/coverage-v8": "2.1.9",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2"
  },
  "dependencies": {
    "ws": "8.18.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.263"
  }
}
